# Keep newly authored project text deterministic without rewriting the supplied proposal files.
/.gitattributes text eol=lf
/CMakeLists.txt text eol=lf
/CMakePresets.json text eol=lf
/CMakeUserPresets.json.example text eol=lf
/vcpkg.json text eol=lf
/.clang-format text eol=lf
/.editorconfig text eol=lf
/.gitignore text eol=lf
/README.md text eol=lf
/progress.md text eol=lf
/docs/** text eol=lf
/src/** text eol=lf
/tests/** text eol=lf
/assets/shaders/** text eol=lf

*.docx binary
*.png binary
*.gif binary
*.mp4 binary
*.glb binary
