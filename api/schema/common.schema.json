{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mini3d.local/api/0.1/common.schema.json",
  "title": "Mini3D API 0.1 common contract",
  "$defs": {
    "uint64": {
      "type": "string", "pattern": "^(0|[1-9][0-9]*)$", "maxLength": 20,
      "format": "uint64-decimal",
      "description": "Canonical decimal string <= 18446744073709551615; validators must implement uint64-decimal."
    },
    "id": {
      "allOf": [{"$ref": "#/$defs/uint64"}, {"pattern": "^[1-9][0-9]*$"}]
    },
    "document": {
      "type": "object", "additionalProperties": false,
      "required": ["instanceId", "documentId"],
      "properties": {
        "instanceId": {"type": "string", "format": "uuid"},
        "documentId": {"type": "string", "format": "uuid"}
      }
    },
    "vec3": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {"type": "number", "minimum": -3.4028234663852886e38, "maximum": 3.4028234663852886e38}
    },
    "color": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {"type": "number", "minimum": 0, "maximum": 1}
    },
    "transform": {
      "type": "object", "additionalProperties": false,
      "required": ["space", "translation", "rotationQuaternion", "scale"],
      "properties": {
        "space": {"const": "local"},
        "translation": {"$ref": "#/$defs/vec3"},
        "rotationQuaternion": {
          "type": "array", "minItems": 4, "maxItems": 4,
          "items": {"type": "number", "minimum": -3.4028234663852886e38, "maximum": 3.4028234663852886e38},
          "not": {"items": {"const": 0}}
        },
        "scale": {
          "allOf": [{"$ref": "#/$defs/vec3"}],
          "items": {"anyOf": [{"type": "number", "maximum": -0.001}, {"type": "number", "minimum": 0.001}]}
        }
      },
      "description": "Right-handed Y-up, current scene units; T*R*S; quaternion [x,y,z,w], nonzero, normalized by application."
    },
    "surface": {
      "type": "object", "additionalProperties": false,
      "required": ["tint", "useVertexColor", "useTexture"],
      "properties": {
        "tint": {"$ref": "#/$defs/color"},
        "useVertexColor": {"type": "boolean"},
        "useTexture": {"type": "boolean"}
      }
    },
    "error": {
      "type": "object", "required": ["code", "message", "recovery"],
      "properties": {
        "code": {"type": "string"}, "message": {"type": "string"},
        "fieldPath": {"type": "string"},
        "recovery": {"enum": ["refetch", "correct_input", "wait", "query_result", "none"]},
        "document": {"$ref": "#/$defs/document"},
        "documentRevision": {"$ref": "#/$defs/uint64"},
        "historyRevision": {"$ref": "#/$defs/uint64"}
      }
    }
  }
}
